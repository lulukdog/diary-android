# 复制为 .env 后填写。不要把真密钥提交到仓库。
# 构建时会读环境变量，没有环境变量时再读这个文件。
# 应用不再在设置里填写密钥。手机上已经保存过的密钥仍然优先；
# 没有保存过时，才用这里的值，在背后生成小结。不要把真密钥提交到仓库。

DEEPSEEK_API_KEY=

# 日记本口令不要写在这里。应用不会把 JOURNAL_APP_TOKEN 打进安装包。
# 在手机「设置」里点「连接日记本」时填写，和网页登录是同一个口令。

# 可选。应用内更新要请求的 version.json 完整地址。
# 留空时使用：
# https://raw.githubusercontent.com/lulukdog/diary-android/main/release/version.json
UPDATE_MANIFEST_URL=
