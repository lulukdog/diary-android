<?xml version="1.0" encoding="utf-8"?>
<!-- 允许 http，方便把更新清单放在自己的局域网。DeepSeek 仍走 https。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
